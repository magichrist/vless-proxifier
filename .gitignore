__pycache__/
*.py[cod]
# No trailing slash: this is a symlink to another project's env, and
# ".venv/" only matches real directories.
.venv
.ruff_cache/
.pytest_cache/
.DS_Store

# Never commit a VLESS link or the profile store
*.vless
profiles.json
link.txt

# Vendored Xray builds. These are 34-61 MB of stripped Go binary and .dat
# files; the downloader in vlessp/xray.py fetches and SHA-256-verifies an
# official release instead, and will happily use a local copy when one is
# present and its hash matches a pinned official build.
xray-macos-arm64/
xray-macos-arm64-v8a/
xray-macos-64/
xray-linux-arm64-v8a/
xray-linux-64/